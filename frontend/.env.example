# 复制为 frontend/.env.local 填入实际值；.env.local 已被根 .gitignore 忽略，不会提交。
# 构建时（npm run build / dev）由 Rsbuild 注入，见 src/api/client.ts。
# 额外的「页面域名 → WebSocket 网关」映射（JSON）；国际站 slg.yuntianyou.cc 已内置，无需写。
PUBLIC_WS_BY_HOST={"slg.example.cn":"wss://slgws.example.cn/ws"}

# 自建反向代理同域部署时设为 true：连接当前页面域名和端口的 /ws（HTTPS 用 wss）。
# 启用后优先于内置域名映射、PUBLIC_WS_BY_HOST 和 localStorage slg.wsUrl。
# 默认关闭，保留开发环境 API_PORT（默认 8080）的直连方式；修改后需重新构建。
PUBLIC_SAME_ORIGIN=false
